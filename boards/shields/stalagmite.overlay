#include <dt-bindings/zmk/matrix_transform.h>

/* 1. Remap SPI1 pins to P1.04 (SCK) and P1.07 (MOSI) using pinctrl */
&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 4)>,   /* 104 -> Port 1, Pin 4 (SRCLK) */
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>;  /* 107 -> Port 1, Pin 7 (SER / Data) */
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 4)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>;
            low-power-enable;
        };
    };
};

/* 2. Configure the SPI bus with your custom pinctrl states and Chip Select pin */
&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";

    /* 106 -> Port 1, Pin 6 (RCLK / Latch) */
    cs-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;

    shifter: gpio595@0 {
        compatible = "zmk,gpio-595";
        status = "okay";
        reg = <0>;

        gpio-controller;
        #gpio-cells = <2>;

        ngpios = <16>; /* 2 daisy-chained 74HC595s */
        spi-max-frequency = <2000000>;
    };
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <17>;
        rows = <6>;

        map = <
            /* Row 0 */
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16)
            /* Row 1 */
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)                   RC(1,16)
            /* Row 2 */
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12)                            RC(2,16)
            /* Row 3 */
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)                   RC(3,16)
            /* Row 4 */
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)          RC(4,13)          RC(4,15) RC(4,16)
            /* Row 5 */
            RC(5,0) RC(5,1) RC(5,2)                         RC(5,6)                         RC(5,10) RC(5,11) RC(5,12)          RC(5,14) RC(5,15) RC(5,16)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;

        // Use the SPI shifter outputs (0 through 15)
        col-gpios
            = <&gpio0 29 (GPIO_ACTIVE_HIGH)>
            , <&gpio0 2  (GPIO_ACTIVE_HIGH)>
            , <&gpio1 15 (GPIO_ACTIVE_HIGH)>
            , <&gpio1 11 (GPIO_ACTIVE_HIGH)>
            , <&gpio0 10 (GPIO_ACTIVE_HIGH)>
            , <&shifter 4 (GPIO_ACTIVE_HIGH)>
            , <&shifter 3 (GPIO_ACTIVE_HIGH)>
            , <&shifter 2 (GPIO_ACTIVE_HIGH)>
            , <&shifter 1 (GPIO_ACTIVE_HIGH)>
            , <&shifter 0 (GPIO_ACTIVE_HIGH)>
            , <&shifter 14 (GPIO_ACTIVE_HIGH)>
            , <&shifter 13 (GPIO_ACTIVE_HIGH)>
            , <&shifter 12 (GPIO_ACTIVE_HIGH)>
            , <&shifter 11 (GPIO_ACTIVE_HIGH)>
            , <&shifter 10 (GPIO_ACTIVE_HIGH)>
            , <&shifter 9 (GPIO_ACTIVE_HIGH)>
            , <&shifter 8 (GPIO_ACTIVE_HIGH)>
    ;
    };
};
